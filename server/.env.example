# Example environment variables — copy to .env and fill in real values.
# Never commit the actual .env file.

# Server
PORT=5000

# Database
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_CONNECTION_STRING

# JWT
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Groq AI — get a free API key at https://console.groq.com
# Free tier: 14,400 requests/day, 500,000 tokens/day (llama-3.3-70b-versatile)
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# ImageKit (for profile photo uploads)
IMAGEKIT_PUBLIC_KEY=REPLACE_WITH_YOUR_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=REPLACE_WITH_YOUR_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=REPLACE_WITH_YOUR_IMAGEKIT_URL_ENDPOINT

# Email (SMTP — Gmail app password works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL="CVPILOT <no-reply@cvpilot.app>"
CONTACT_EMAIL=your-email@gmail.com

# Frontend URL (used in password reset emails)
CLIENT_URL=http://localhost:5173
